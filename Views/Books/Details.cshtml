@model Bookstore.Models.Book
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Book Details";
}

<style>
    /* Book Details Page Styles */
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --card-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
        --hover-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
        --border-radius: 20px;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Page Header */
    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem 0;
        margin: -1.5rem -1.5rem 3rem -1.5rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23ffffff' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
    }

    .page-header h1 {
        font-size: 2.75rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        position: relative;
        z-index: 1;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }

    .page-header .book-title {
        font-size: 1.2rem;
        opacity: 0.9;
        position: relative;
        z-index: 1;
        font-weight: 400;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }

    /* Book Details Container */
    .book-details-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    /* Book Card */
    .book-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        border: 1px solid #e9ecef;
        margin-bottom: 2rem;
        position: relative;
    }

    /* Book Cover Section */
    .book-cover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 4rem 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
        min-height: 300px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-cover::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    .book-icon {
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transform: perspective(1000px) rotateY(-10deg);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        transition: var(--transition);
    }

    .book-icon:hover {
        transform: perspective(1000px) rotateY(0deg);
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
    }

    .book-icon i {
        font-size: 4rem;
        color: white;
    }

    /* Book Info Section */
    .book-info {
        padding: 3rem;
    }

    /* Detail Items */
    .detail-item {
        padding: 1.5rem;
        border-radius: 12px;
        background: #f8fafc;
        margin-bottom: 1.5rem;
        border-left: 4px solid #667eea;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

    .detail-item:hover {
        transform: translateX(10px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .detail-item::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(to bottom, #667eea, #764ba2);
    }

    .detail-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        font-weight: 600;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .detail-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.4;
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
    }

    /* Price Badge */
    .price-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #2ecc71, #27ae60);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.5rem;
        box-shadow: 0 10px 20px rgba(46, 204, 113, 0.3);
    }

    /* Book Metadata */
    .book-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: #f1f5f9;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        font-size: 0.9rem;
        color: #475569;
    }

    .meta-item i {
        color: #667eea;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid #e9ecef;
        flex-wrap: wrap;
    }

    .btn {
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: var(--transition);
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        text-decoration: none;
        min-width: 140px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
        background: #f1f5f9;
        color: #475569;
        border: 2px solid #e2e8f0;
    }

    .btn-secondary:hover {
        background: #e2e8f0;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .btn-warning {
        background: linear-gradient(135deg, #f39c12, #e67e22);
        color: white;
    }

    .btn-warning:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(243, 156, 18, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, #e74c3c, #c0392b);
        color: white;
    }

    .btn-danger:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(231, 76, 60, 0.4);
    }

    /* Animation */
   @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

   @@keyframes float {
        0%, 100% {
            transform: translateY(0) perspective(1000px) rotateY(-10deg);
        }
        50% {
            transform: translateY(-20px) perspective(1000px) rotateY(-10deg);
        }
    }

    .fade-in-up {
        animation: fadeInUp 0.6s ease-out;
    }

    .float-animation {
        animation: float 6s ease-in-out infinite;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
    }

    .stat-card {
        background: white;
        border-radius: var(--border-radius);
        padding: 1.5rem;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        border: 1px solid #e9ecef;
        transition: var(--transition);
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: #667eea;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-size: 0.9rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Responsive */
   @@media (max-width: 768px) {
        .page-header {
            padding: 2rem 0;
            margin: -1rem -1rem 2rem -1rem;
        }

        .page-header h1 {
            font-size: 2rem;
        }

        .book-cover {
            min-height: 200px;
            padding: 2rem 1rem;
        }

        .book-icon {
            width: 120px;
            height: 120px;
        }

        .book-icon i {
            font-size: 3rem;
        }

        .book-info {
            padding: 1.5rem;
        }

        .detail-value {
            font-size: 1.25rem;
        }

        .action-buttons {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }

    /* Loading Animation */
   @@keyframes shimmer {
        0% {
            background-position: -200% center;
        }
        100% {
            background-position: 200% center;
        }
    }

    .loading {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }

    /* QR Code Section (Optional) */
    .qr-section {
        margin-top: 2rem;
        text-align: center;
        padding: 1.5rem;
        background: #f8fafc;
        border-radius: var(--border-radius);
        border: 2px dashed #cbd5e1;
    }

    .qr-label {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header fade-in-up">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <h1>📖 Book Details</h1>
                    <p class="book-title fade-in-up" style="animation-delay: 0.2s">
                        Detailed information about "<strong>@Model.Title</strong>"
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Book Details Container -->
    <div class="container book-details-container fade-in-up" style="animation-delay: 0.4s">
        <!-- Book Card -->
        <div class="book-card">
            <!-- Book Cover Section -->
            <div class="book-cover">
                <div class="book-icon float-animation">
                    <i class="bi bi-book-half"></i>
                </div>
            </div>

            <!-- Book Info Section -->
            <div class="book-info">
                <!-- Title Detail -->
                <div class="detail-item">
                    <div class="detail-label">
                        <div class="detail-icon">
                            <i class="bi bi-card-heading"></i>
                        </div>
                        Book Title
                    </div>
                    <div class="detail-value">
                        @Model.Title
                    </div>
                </div>

                <!-- Author Detail -->
                <div class="detail-item">
                    <div class="detail-label">
                        <div class="detail-icon">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        Author
                    </div>
                    <div class="detail-value">
                        @Model.Author
                    </div>
                </div>

                <!-- Price Detail -->
                <div class="detail-item">
                    <div class="detail-label">
                        <div class="detail-icon">
                            <i class="bi bi-tag"></i>
                        </div>
                        Price
                    </div>
                    <div class="detail-value">
                        <span class="price-badge">
                            <i class="bi bi-currency-dollar"></i>
                            @Model.Price
                        </span>
                    </div>
                </div>

                <!-- Additional Metadata -->
                @if (!string.IsNullOrEmpty(Model.Genre))
                {
                    <div class="detail-item">
                        <div class="detail-label">
                            <div class="detail-icon">
                                <i class="bi bi-bookmark"></i>
                            </div>
                            Genre
                        </div>
                        <div class="detail-value">
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                                @Model.Genre
                            </span>
                        </div>
                    </div>
                }

                <!-- Book Metadata -->
                <div class="book-meta">
                    <div class="meta-item">
                        <i class="bi bi-calendar3"></i>
                        <span>Added: @DateTime.Now.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="meta-item">
                        <i class="bi bi-hash"></i>
                        <span>ID: @Model.Id</span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square me-2"></i> Edit Book
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i> Delete Book
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i> Back to Books
                    </a>
                </div>
            </div>
        </div>

        <!-- Additional Stats (Optional) -->
        <div class="stats-grid">
            <div class="stat-card fade-in-up" style="animation-delay: 0.6s">
                <div class="stat-value">
                    <i class="bi bi-clock-history me-2"></i>
                    Recent
                </div>
                <div class="stat-label">Added this month</div>
            </div>

            <div class="stat-card fade-in-up" style="animation-delay: 0.7s">
                <div class="stat-value">
                    <i class="bi bi-star me-2"></i>
                    Popular
                </div>
                <div class="stat-label">In same genre</div>
            </div>

            <div class="stat-card fade-in-up" style="animation-delay: 0.8s">
                <div class="stat-value">
                    <i class="bi bi-share me-2"></i>
                    Share
                </div>
                <div class="stat-label">Share this book</div>
            </div>
        </div>

        <!-- QR Code Section (Optional) -->
        <div class="qr-section fade-in-up" style="animation-delay: 0.9s">
            <div class="qr-label">Quick Access</div>
            <div class="text-muted small mb-2">
                Scan QR code to save this book
            </div>
            <div style="width: 150px; height: 150px; background: #f8fafc; border-radius: 10px; margin: 0 auto; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-qr-code fs-1 text-muted"></i>
            </div>
            <div class="text-muted small mt-2">
                Book ID: @Model.Id
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<!-- Interactive Scripts -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Add hover effect to detail items
        const detailItems = document.querySelectorAll('.detail-item');
        detailItems.forEach(item => {
            item.addEventListener('mouseenter', function() {
                const icon = this.querySelector('.detail-icon');
                if (icon) {
                    icon.style.transform = 'scale(1.1) rotate(5deg)';
                }
            });

            item.addEventListener('mouseleave', function() {
                const icon = this.querySelector('.detail-icon');
                if (icon) {
                    icon.style.transform = 'scale(1) rotate(0deg)';
                }
            });
        });

        // Price animation
        const priceBadge = document.querySelector('.price-badge');
        if (priceBadge) {
            setInterval(() => {
                priceBadge.style.transform = 'scale(1.05)';
                setTimeout(() => {
                    priceBadge.style.transform = 'scale(1)';
                }, 300);
            }, 5000);
        }

        // Copy book ID to clipboard
        const copyIdBtn = document.createElement('button');
        copyIdBtn.innerHTML = '<i class="bi bi-clipboard me-2"></i>Copy ID';
        copyIdBtn.className = 'btn btn-outline-primary btn-sm mt-2';
        copyIdBtn.style.display = 'none';
        
        const bookIdElement = document.querySelector('.meta-item span:contains("ID:")');
        if (bookIdElement) {
            bookIdElement.parentElement.appendChild(copyIdBtn);
            copyIdBtn.style.display = 'inline-flex';
            
            copyIdBtn.addEventListener('click', function() {
                const bookId = '@Model.Id';
                navigator.clipboard.writeText(bookId).then(() => {
                    const originalText = copyIdBtn.innerHTML;
                    copyIdBtn.innerHTML = '<i class="bi bi-check2 me-2"></i>Copied!';
                    copyIdBtn.classList.remove('btn-outline-primary');
                    copyIdBtn.classList.add('btn-outline-success');
                    
                    setTimeout(() => {
                        copyIdBtn.innerHTML = originalText;
                        copyIdBtn.classList.remove('btn-outline-success');
                        copyIdBtn.classList.add('btn-outline-primary');
                    }, 2000);
                });
            });
        }

        // Share functionality
        const shareBtns = document.querySelectorAll('.stat-card:last-child');
        shareBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                if (navigator.share) {
                    navigator.share({
                        title: '@Model.Title',
                        text: 'Check out this book: @Model.Title by @Model.Author',
                        url: window.location.href,
                    });
                } else {
                    // Fallback: Copy URL to clipboard
                    navigator.clipboard.writeText(window.location.href).then(() => {
                        alert('Link copied to clipboard!');
                    });
                }
            });
        });
    });
</script>

<!-- Helper for contains selector -->
<script>
    // jQuery-like contains selector for vanilla JS
    document.querySelectorAll = document.querySelectorAll || function (selectors) {
        var style = document.createElement('style'), elements = [], element;
        document.head.appendChild(style);
        document._qsa = [];
        
        style.styleSheet.cssText = selectors + '{x:expression(document._qsa && document._qsa.push(this))}';
        document.head.removeChild(style);
        
        while (document._qsa.length) {
            element = document._qsa.shift();
            element.style.removeAttribute('x');
            elements.push(element);
        }
        document._qsa = null;
        return elements;
    };
</script>
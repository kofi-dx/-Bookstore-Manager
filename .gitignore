# Create .gitignore file
@"
# Build outputs
bin/
obj/
*.exe
*.dll
*.pdb
*.cache
*.config

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
*.user
*.suo
*.userosscache
*.sln.docstates

# User-specific files
*.rsuser
*.userprefs

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Database
*.db
*.db-shm
*.db-wal

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and backups
*.log
*.bak

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp
"@ | Out-File -FilePath ".gitignore" -Encoding UTF8